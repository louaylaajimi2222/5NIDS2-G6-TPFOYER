<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- localRepository
   | The path to the local repository maven will use to store artifacts.
   |
   | Default: ${user.home}/.m2/repository
   -->
  <!-- <localRepository>/path/to/local/repo</localRepository> -->

  <!-- interactiveMode
   | Determines whether Maven prompts for input.
   |
   | Default: true
   -->
  <!-- <interactiveMode>true</interactiveMode> -->

  <!-- offline
   | Determines whether Maven connects to the network.
   |
   | Default: false
   -->
  <!-- <offline>false</offline> -->

  <!-- pluginGroups
   | Additional group identifiers for plugin lookup.
   -->
  <pluginGroups>
    <!-- <pluginGroup>com.your.plugins</pluginGroup> -->
  </pluginGroups>

  <!-- proxies
   | List of proxies for network connections.
   -->
  <proxies>
    <!--
    <proxy>
      <id>optional</id>
      <active>true</active>
      <protocol>http</protocol>
      <username>proxyuser</username>
      <password>proxypass</password>
      <host>proxy.host.net</host>
      <port>80</port>
      <nonProxyHosts>local.net|some.host.com</nonProxyHosts>
    </proxy>
    -->
  </proxies>

  <!-- servers
   | Authentication profiles for connecting to remote servers.
   -->
  <servers>
    <server>
      <id>deploymentRepo</id>
      <username>admin</username>
      <password>83849454-3e82-4eef-b56d-dd613ca1b8b3</password>
    </server>
    <!--
    <server>
      <id>siteServer</id>
      <privateKey>/path/to/private/key</privateKey>
      <passphrase>optional; leave empty if not used.</passphrase>
    </server>
    -->
  </servers>

  <!-- mirrors
   | List of mirrors for downloading artifacts.
   -->
  <mirrors>
    <!--
    <mirror>
      <id>mirrorId</id>
      <mirrorOf>repositoryId</mirrorOf>
      <name>Human Readable Name for this Mirror.</name>
      <url>http://my.repository.com/repo/path</url>
    </mirror>
    -->
  </mirrors>

  <!-- profiles
   | Profiles that can modify the build process.
   -->
  <profiles>
    <!-- Example profile -->
    <profile>
      <id>jdk-1.4</id>
      <activation>
        <jdk>1.4</jdk>
      </activation>
      <repositories>
        <repository>
          <id>jdk14</id>
          <name>Repository for JDK 1.4 builds</name>
          <url>http://www.myhost.com/maven/jdk14</url>
          <layout>default</layout>
          <!-- Remove snapshotPolicy if present; it's invalid in settings.xml -->
        </repository>
      </repositories>
    </profile>
    
    <profile>
      <id>env-dev</id>
      <activation>
        <property>
          <name>target-env</name>
          <value>dev</value>
        </property>
      </activation>
      <properties>
        <tomcatPath>/path/to/tomcat/instance</tomcatPath>
      </properties>
    </profile>
  </profiles>

  <!-- activeProfiles
   | Profiles that are active for all builds.
   -->
  <!--
  <activeProfiles>
    <activeProfile>alwaysActiveProfile</activeProfile>
    <activeProfile>anotherAlwaysActiveProfile</activeProfile>
  </activeProfiles>
  -->

</settings>
